{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1314"
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "app", "dmg", "msi", "nsis"],
    "linux": {
      "deb": {},
      "rpm": {}
    },

    "windows": {
      "nsis": {}
    },

    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "productName": "my-music",
  "mainBinaryName": "my-music",
  "version": "0.4.5",
  "identifier": "com.my-music.app",
  "plugins": {
    "fs": {},
    "asset": {}
  },
  "app": {
    "security": {
      "capabilities": ["main-capability"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APP_DATA/**",
          "$APP_CONFIG/**",
          "$TEMP/**"
        ]
      },
      "csp": "default-src 'self'; media-src *; img-src 'self' asset: http: https: data:; script-src 'self';; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "devtools": true,
        "title": "my-music",
        "minWidth": 200,
        "minHeight": 200,
        "decorations": false,
        "resizable": true,
        "transparent": true,
        "useHttpsScheme": false
      }
    ]
  }
}